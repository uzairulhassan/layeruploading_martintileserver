# Copy this file to .env and fill in real values before running the project.

DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# Shared PostGIS instance from ../geo-infra (service `postgis`, database `geolayers`).
# The password = GEOLAYERS_DB_PASSWORD in geo-infra/.env
DATABASE_URL=postgis://geolayers_user:change-me-geolayers@postgis:5432/geolayers

# Mapbox GL JS basemap token (https://account.mapbox.com/access-tokens/)
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_token_here

# Tiles are served by the shared Nginx on this app's port (:8081) at /tiles/geolayers_tile/...
# A path is made absolute per request. Use a full URL only if tiles live on another host.
TILES_PUBLIC_URL=/tiles
# Django -> shared Martin inside the geo_shared network (share-link tile proxy)
MARTIN_INTERNAL_URL=http://martin:3000
# Nginx auth_request secret: = GEOLAYERS_TILE_AUTH_SHARED_SECRET in ../geo-infra/.env
TILE_AUTH_SHARED_SECRET=change-me-another-long-random-string

# JWT lifetimes (minutes / days)
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# Path to the ogr2ogr binary (GDAL) used to import shapefiles into PostGIS
OGR2OGR_PATH=ogr2ogr